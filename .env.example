# Modelo do .env LOCAL usado pelo docker-compose.yml desta pasta.
# Copie para ".env" e preencha. NUNCA coloque valores reais aqui (repo público).
# Gere segredos com: python -c "import secrets; print(secrets.token_hex(32))"

MYSQL_ROOT_PASSWORD=
# Mesma senha da DATABASE_URL em backend/.env (Modo B)
MYSQL_PASSWORD=

# Idêntico ao JWT_SECRET de frontend/.env.local (Modo B)
JWT_SECRET=

ADMIN_EMAIL=admin@exemplo.local
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=
