# /infra/env/staging.env.example — modelo do .env do STAGING na VM
# Na VM: /srv/auditoria/staging/.env (root, 600). NUNCA coloque valores reais aqui.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Ambiente (lidos pelo compose.app.yml e pelo deploy.sh) ---
# Tem que ser exatamente este nome: dele saem os aliases e a rede auditoria-staging-edge
COMPOSE_PROJECT_NAME=auditoria-staging
IMAGE_REPO=ghcr.io/desenvolvimento-stwbrasil/projeto-auditoria-plataforma
# "staging" acompanha a develop; sha-<7> fixa uma versão (rollback)
IMAGE_TAG=staging

# --- Endereço usado pelo navegador (túnel SSH), sem barra final ---
APP_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# --- JWT (diferente do da produção) ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Admin inicial (seed_admin.py) ---
ADMIN_EMAIL=
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=

# --- SMTP (opcional; vazio = sem e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
