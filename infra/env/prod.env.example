# /infra/env/prod.env.example — modelo do .env da PRODUÇÃO na VM
# Na VM: /srv/auditoria/prod/.env (root, 600). NUNCA coloque valores reais aqui.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Todos os segredos DIFERENTES dos do staging.

# --- Ambiente (lidos pelo compose.app.yml e pelo deploy.sh) ---
# Tem que ser exatamente este nome: dele saem os aliases e a rede auditoria-prod-edge
COMPOSE_PROJECT_NAME=auditoria-prod
IMAGE_REPO=ghcr.io/desenvolvimento-stwbrasil/projeto-auditoria-plataforma
# "prod" acompanha a main; prod-<7> ou sha-<7> fixa uma versão (rollback)
IMAGE_TAG=prod

# --- Endereço público, sem barra final ---
# Hoje só decide a flag Secure dos cookies (http:// = sem Secure), então
# vale tanto para o túnel (http://localhost:8080) quanto para o IP.
# Trocar para https://<domínio> só quando o HTTPS existir (INFRA-09).
APP_URL=http://SEU_IP_AQUI
CORS_ALLOWED_ORIGINS=http://SEU_IP_AQUI

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# --- Tetos de memória (padrões no compose.app.yml) ---
# MYSQL_MEM_LIMIT=768m
# BACKEND_MEM_LIMIT=384m
# FRONTEND_MEM_LIMIT=384m

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Admin inicial (seed_admin.py) ---
ADMIN_EMAIL=
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=

# --- SMTP (opcional; vazio = sem e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
