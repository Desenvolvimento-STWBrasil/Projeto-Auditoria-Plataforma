# Copie para .env e ajuste. NUNCA commite o .env, e NUNCA coloque valores
# reais neste arquivo — ele É versionado (ver B-C23 em docs/relatorio_bugs.md).
#
# Senha com caracteres especiais (@ # % + etc.): codifique na URL, ex. @ -> %40
# https://docs.sqlalchemy.org/en/20/core/engines.html#database-urls

DATABASE_URL=mysql+pymysql://auditoria_app:TROQUE_ESTA_SENHA@127.0.0.1:3307/auditoria

# Lidas pelo backend/docker-compose.yml ao CRIAR o container do MySQL.
# MYSQL_PASSWORD tem de ser exatamente a senha usada na DATABASE_URL acima.
MYSQL_ROOT_PASSWORD=TROQUE_ESTA_SENHA_ROOT
MYSQL_PASSWORD=TROQUE_ESTA_SENHA

PROJECT_NAME=Auditoria API
API_PREFIX_V1=/api/v1
IS_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Precisa ser IDÊNTICO ao JWT_SECRET de frontend/.env.local
JWT_SECRET=TROQUE_POR_UMA_CHAVE_HEX_DE_64_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Usados apenas por scripts/seed_admin.py
ADMIN_EMAIL=admin@exemplo.local
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=TROQUE_ESTA_SENHA

# Mantenha false em produção — use POST /onboarding/principal-user
ALLOW_PUBLIC_REGISTRATION=false

# SMTP (opcional). Sem estas variáveis, o e-mail vira log estruturado em dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
